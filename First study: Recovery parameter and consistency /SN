## storing the "task id"
k <- commandArgs(trailingOnly = TRUE)[1]

# True values
betas=c(1,2)
Beta = matrix(c(1,2),ncol=1)
phi1=0.6
phi2=-0.2
phiAR=c(phi1,phi2) 
D1=2
lambda=3
sigma2e=0.25
nuT=NULL
p_ast=length(Beta)+3+length(phiAR)+length(nuT)
thetav=c(as.vector(Beta),sigma2e,phiAR,sqrt(D1),lambda)
################################################################################

n=1000
nin=50*rep(1,n)
ind=1:(n*50)
X=c()
Subject=c()
timet=c()
for (i in 1:n){
     ni=nin[i]
     t1i=matrix(runif(ni,0.6,1.6),ni,1)
     Xi = cbind(runif(ni,0,10),runif(ni,0,2))
     X=rbind(X,Xi)
     Subject=rbind(Subject,matrix(rep(i,ni)))
     timet=rbind(timet,matrix(1:ni))
     }

## setting seed for reproducibility
set.seed(NULL)
require(skewlmm)
Y=c()  
for (i in 1:n){
    ni=nin[i]
    Xi = X[ind[(ni*(i-1)+1):(ni*i)],]
    Zi = matrix(1,nrow=ni)            
    mui=Xi%*%Beta  
    auxi=rsmsn.lmm(1:ni, Xi, Zi, sigma2e, D1, betas, lambda, depStruct = "ARp", phi = phiAR, distr = "sn", nu = NULL)
    Y=rbind(Y,matrix(auxi$y))    
}
dat1=data.frame(y=Y,x=X,Subject=Subject,time=timet)
thetaj=smsn.lmm(dat1, formFixed = y ~ -1 + x.1 + x.2, formRandom = ~ 1, distr = 'sn', groupVar = "Subject", timeVar="time", depStruct = "ARp", pAR=length(phiAR), control = lmmControl(algorithm = "EM", quiet = TRUE,parallelphi=FALSE,parallelnu=FALSE))
theta=as.vector(thetaj$theta)  # beta,sigma2e,phi,Dmeio,lambda,nu
eptheta=thetaj$std.error
aux1=theta-1.96*eptheta
aux2=theta+1.96*eptheta
cob=((thetav-aux1)>0)&((thetav-aux2)<0)
thetam=c(as.vector(theta),eptheta,cob)
## saving results
filename <-
  sprintf("data1000/sn1000pack_%s.rds", k)
saveRDS(thetam, file = filename)

